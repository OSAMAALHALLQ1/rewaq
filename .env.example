NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EMPLOYEE_CODE_ENCRYPTION_KEY=
RAWAQ_OWNER_EMAIL=

# Secret for platform-admin session JWTs and the signed 8-hour demo-trial
# ticket. Without it the admin panel rejects logins and the trial window is
# unenforced. Generate a long random value.
INTERNAL_ADMIN_SECRET=

# Server-only demo account (8-hour free trial). Must belong to the isolated
# demo organization only.
RAWAQ_DEMO_MODE=
RAWAQ_DEMO_EMAIL=
RAWAQ_DEMO_PASSWORD=

ADMIN_REGISTRATION_EMAIL=

# Server-only email delivery. Select exactly one provider: smtp or resend.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Rewaq <noreply@your-domain.com>

# Gmail SMTP recommendation: smtp.gmail.com, port 465, secure true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Optional when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Social Media Publishing (Marketing)
AYRSHARE_API_KEY=

# ZATCA E-Invoicing Compliance (Saudi Arabia)
NEXT_PUBLIC_SELLER_VAT_NUMBER=
